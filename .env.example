# ============================================================
# Agente Virtual Musical — Configuração de Ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo ".env" real.
# ============================================================

# --- Provedor de LLM: Groq (gratuito) OU OpenAI (pago) ---
# Defina APENAS UM dos dois. Se OPENAI_API_KEY estiver presente, ele tem prioridade.
# Groq só é usado como LLM se OPENAI_API_KEY estiver vazio.

# Opção A — Groq (gratuito, recomendado para testes)
# Crie sua chave em: console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_sua_chave_aqui

# Opção B — OpenAI (pago, recomendado para produção)
# Crie sua chave em: platform.openai.com → API Keys → Create new secret key
# OPENAI_API_KEY=sk-proj-...

# --- Modelo do LLM ---
# Groq  → llama-3.3-70b-versatile (padrão automático com GROQ_API_KEY)
# OpenAI → gpt-4o-mini            (padrão automático com OPENAI_API_KEY)
# Descomente para forçar um modelo específico:
# LLM_MODEL=llama-3.3-70b-versatile

# --- Modelo Whisper via API Groq ---
# Opções: whisper-large-v3-turbo (rápido) | whisper-large-v3 (máxima qualidade)
WHISPER_MODEL=whisper-large-v3-turbo

# --- Flags de desenvolvimento ---
# Defina como "true" para desativar o cooldown de 6h durante testes
DISABLE_COOLDOWN=false

# --- Modo produção (atendimento humano) ---
# Tempo (em minutos) que o bot fica desativado para um ouvinte que escolheu
# falar com a produção. O timer reinicia a cada nova mensagem do ouvinte.
PRODUCAO_TIMEOUT_MIN=30

# --- Pílulas de curiosidade musical ---
# Após um pedido bem-sucedido, o bot envia uma curiosidade curta sobre a
# música (uma vez por ouvinte+música). Requer OPENAI_API_KEY configurada.
PILULAS_ATIVADAS=true
PILULAS_MODELO=gpt-4o

# --- WAHA (WhatsApp HTTP API) ---
# docker compose up -d  →  http://localhost:3001/dashboard
WAHA_URL=http://localhost:3001
WAHA_API_KEY=sua_chave_waha_aqui
WAHA_SESSION=default

# --- Diretórios de músicas (Windows) ---
# Pasta raiz que contém todas as subpastas de músicas do ZaraRadio
# (FLASHBACK ANIMADO, POP ANIMADO, acervo_limpo, fila_zara, etc.)
# Use barras normais (/, não \). As demais pastas são gerenciadas pelo Docker.
MUSICAS_DIR=C:/LUZ FM/AR/MUSICAS

# Pasta onde o agente entrega o arquivo para o ZaraRadio tocar agora (1 arquivo por vez)
FILA_ZARA_DIR=C:/LUZ FM/AR/MUSICAS/fila_zara

# Fila real dos pedidos (não monitorada pelo ZaraRadio — gerenciada pelo watcher)
QUEUE_DIR=C:/LUZ FM/AR/MUSICAS/queue_pedidos

# Pasta onde o ZaraRadio grava CurrentSong.txt (Options → Log no ZaraRadio)
# Normalmente C:\Users\<usuario> ou a pasta de instalação do ZaraRadio
CURRENT_SONG_DIR=C:/Users/user

# --- Banco de dados (Supabase / PostgreSQL) ---
# Connection string do projeto Supabase:
# Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# --- Perfil da assistente (tom, mensagens, repertório) ---
# ASSISTANT_PROFILE_PATH: caminho DENTRO do container onde o servidor lê o
# perfil. Normalmente não precisa mudar — é fixado pelo compose.
# ASSISTANT_PROFILE_PATH=/app/config/assistente.md

# ASSISTANT_PROFILE_FILE: caminho no HOST (fora do container) do arquivo
# assistente.md que será montado em ASSISTANT_PROFILE_PATH. Deixe em branco
# para usar o padrão de cada compose: ./core/luzia/luzia.md em
# docker-compose.yml (dev, tem o repo) e ./assistente.md em
# docker-compose.dist.yml (cliente, criado pelo instalar.bat).
# ASSISTANT_PROFILE_FILE=./assistente.md

# --- Repertório (item A — liberação do sertanejo) ---
# Lista separada por vírgula de gêneros sempre aceitos, independente do
# veredito is_flashback do classificador. Comparação normalizada (sem
# acento, minúsculas) por prefixo de palavra. Vazio desliga o item A.
GENEROS_SEMPRE_ACEITOS=sertanejo

# --- Throttle do YouTube (item B — protege contra bloqueio por volume) ---
# YT_THROTTLE_ATIVADO=false desliga o throttle (rollback sem rebuild).
YT_THROTTLE_ATIVADO=true
# Intervalo mínimo (segundos) desde o FIM da chamada anterior antes de uma busca.
YT_THROTTLE_BUSCA_S=30
# Intervalo mínimo (segundos) antes de uma tentativa de download do mesmo pedido.
YT_THROTTLE_TENTATIVA_S=8
# Jitter aditivo (0 a 30% do intervalo) para não gerar um padrão de automação.
YT_THROTTLE_JITTER_PCT=0.3
# Teto de espera acumulada (segundos) por pedido antes de abortar com EsperaExcedida.
YT_THROTTLE_MAX_ESPERA_S=150
# Pedidos simultâneos aguardando o throttle; o excedente recebe recusa amigável.
YT_THROTTLE_MAX_FILA=4

# --- Canal obrigatório de voz (item C — a cada N textos, convite para áudio) ---
# CANAL_VOZ_ATIVADO=false desliga o gate (rollback sem rebuild).
CANAL_VOZ_ATIVADO=true
# Pedidos atendidos por texto, por ciclo, antes do bloqueio.
CANAL_TEXTO_MAX=3
# Duração (minutos) do bloqueio de texto. Um pedido por voz zera o ciclo.
CANAL_BLOQUEIO_MIN=60
# Limite (dias) da consulta de histórico usada para derivar o bloqueio.
CANAL_HISTORICO_DIAS=90

# --- YouTube: cliente do player e PO Token provider (fix do HTTP 403) ---
# Já existem em código (core/downloader.py); documentados aqui para referência.
# YT_PLAYER_CLIENT=tv_simply
# POT_PROVIDER_URL=http://bgutil-pot:4416

# --- Composer (texto variável via LLM) ---
# COMPOSER_ENABLED=false força sempre as mensagens fixas (canned), sem custo de LLM.
# COMPOSER_ENABLED=true

# --- Alertas e relatório semanal ---
# Formato: JID completo do WhatsApp (ex: 5534999999999@c.us)
# Deixe em branco para desativar.

# Número do dono/gerente da rádio (recebe relatório semanal + alertas)
NUMERO_DONO=

# Número do desenvolvedor (recebe alertas de indisponibilidade)
NUMERO_DEV=
