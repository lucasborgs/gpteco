workspace/acervo_limpo/
workspace/fila_zara/
workspace/temp/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# macOS
.DS_Store

# Arquivos temporários gerados em desenvolvimento
qr.html
qr.png

# Configuração local do Claude Code (específico do desenvolvedor)
.claude/
