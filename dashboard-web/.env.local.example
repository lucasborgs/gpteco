# ============================================================
# Dashboard (Next.js) — environment configuration
# Copy this file to ".env.local" and fill in the values.
# Never commit the real ".env.local".
# ============================================================

# --- Database (Supabase / PostgreSQL) ---
# Same connection string used by the backend. The dashboard reads the
# dim_pedidos table directly to render analytics.
# Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# --- AI insights panel (optional) ---
# Enables the "AI Analysis" panel in the dashboard. If left empty, the panel
# shows a message saying AI insights are not configured.
OPENAI_API_KEY=

# Model used for the insights panel (optional, defaults to gpt-4o-mini).
# INSIGHTS_MODELO=gpt-4o-mini
